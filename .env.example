PORT=9443
# Headless by default if unset or empty. Set to false to show Chrome during Selenium login.
SELENIUM_HEADLESS=true
# Milliseconds to wait for Steam Mobile App sign-in approval before failing (default 120000).
STEAM_MOBILE_APPROVAL_WAIT_MS=120000
# Persistent Chrome profile directory for Steam session (default: ./.chrome-steam-profile).
# CHROME_USER_DATA_DIR=
# Days between automatic token refreshes using the saved profile (default 5).
TOKEN_AUTO_REFRESH_DAYS=5
# Stored token validity window in days (default 14).
TOKEN_EXPIRY_DAYS=14
